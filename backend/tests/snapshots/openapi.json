            "title": "Lat",
            "type": "number"
          },
          "lon": {
            "title": "Lon",
            "type": "number"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "population": {
            "title": "Population",
            "type": "integer"
          },
          "tz": {
            "title": "Tz",
            "type": "string"
          }
        },
        "required": [
          "name",
          "admin1",
          "country",
          "lat",
          "lon",
          "tz",
          "population"
        ],
        "title": "PlaceOut",
        "type": "object"
      },
      "SettingsIn": {
        "additionalProperties": false,
        "properties": {
          "ayanamsa": {
            "default": "LAHIRI",
            "enum": [
              "LAHIRI",
              "RAMAN",
              "KP",
              "FAGAN_BRADLEY"
            ],
            "title": "Ayanamsa",
            "type": "string"
          },
          "dasha_year_days": {
            "default": 365.25,
            "maximum": 400.0,
            "minimum": 300.0,
            "title": "Dasha Year Days",
            "type": "number"
          },
          "node": {
            "default": "MEAN",
            "enum": [
              "MEAN",
              "TRUE"
