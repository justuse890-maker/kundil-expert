              }
            ],
            "description": "Fixed offset from UTC, e.g. \"+05:30\"",
            "title": "Utc Offset"
          },
          "vargas": {
            "anyOf": [
              {
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Subset of [1, 2, 3, 4, 7, 9, 10, 12, 16, 20, 24, 27, 30, 40, 45, 60]; default all",
            "title": "Vargas"
          }
        },
        "required": [
          "date",
          "lat",
          "lon"
        ],
        "title": "KundliRequest",
        "type": "object"
