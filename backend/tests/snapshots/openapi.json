{
  "components": {
    "schemas": {
      "AnalysisRequest": {
        "additionalProperties": false,
        "description": "The `/kundli` body plus the analysis options.",
        "properties": {
          "alt": {
            "default": 0.0,
            "maximum": 10000.0,
            "minimum": -500.0,
            "title": "Alt",
            "type": "number"
          },
          "dasha_depth": {
            "default": 3,
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Dasha Depth",
            "type": "integer"
          },
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "fold": {
            "anyOf": [
              {
                "enum": [
                  0,
                  1
                ],
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "0 = first, 1 = second occurrence",
            "title": "Fold"
          },
          "gender": {
            "anyOf": [
              {
                "enum": [
                  "male",
                  "female"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Used only for the marriage karaka (Venus male, Jupiter female)",
            "title": "Gender"
          },
          "lat": {
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Lat",
            "type": "number"
          },
          "lmt": {
            "default": false,
            "description": "Local mean time at the longitude (lon/15 hours)",
            "title": "Lmt",
            "type": "boolean"
          },
          "lon": {
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Lon",
            "type": "number"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "now_utc": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Start of the 24-month timeline; defaults to the current time",
            "title": "Now Utc"
          },
          "settings": {
            "$ref": "#/components/schemas/SettingsIn"
          },
          "time": {
            "anyOf": [
              {
                "format": "time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "HH:MM[:SS]; may be omitted if time_known=false",
            "title": "Time"
          },
          "time_known": {
            "default": true,
            "title": "Time Known",
            "type": "boolean"
          },
          "tz": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "IANA zone, e.g. Asia/Kolkata",
            "title": "Tz"
          },
          "utc_offset": {
            "anyOf": [
              {
                "pattern": "^[+-][0-9]{2}:[0-9]{2}(:[0-9]{2})?$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Fixed offset from UTC, e.g. \"+05:30\"",
            "title": "Utc Offset"
          },
          "vargas": {
            "anyOf": [
              {
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Subset of [1, 2, 3, 4, 7, 9, 10, 12, 16, 20, 24, 27, 30, 40, 45, 60]; default all",
            "title": "Vargas"
          }
        },
        "required": [
          "date",
          "lat",
          "lon"
        ],
        "title": "AnalysisRequest",
        "type": "object"
      },
      "DailyRequest": {
        "additionalProperties": false,
        "description": "The `/kundli` body (the birth chart) plus the day and, optionally, where the user is now.\n\n`today` is a local civil date at the current place. `current_lat`/`current_lon` default to\nthe birth place (give both or neither); `current_tz` (IANA) defaults to the birth zone (for\nan LMT birth, local mean time at the current longitude).",
        "properties": {
          "alt": {
            "default": 0.0,
            "maximum": 10000.0,
            "minimum": -500.0,
            "title": "Alt",
            "type": "number"
          },
          "current_lat": {
            "anyOf": [
              {
                "maximum": 90.0,
                "minimum": -90.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Lat"
          },
          "current_lon": {
            "anyOf": [
              {
                "maximum": 180.0,
                "minimum": -180.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Lon"
          },
          "current_tz": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "IANA zone, e.g. Asia/Dubai",
            "title": "Current Tz"
          },
          "dasha_depth": {
            "default": 3,
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Dasha Depth",
            "type": "integer"
          },
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "fold": {
            "anyOf": [
              {
                "enum": [
                  0,
                  1
                ],
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "0 = first, 1 = second occurrence",
            "title": "Fold"
          },
          "lat": {
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Lat",
            "type": "number"
          },
          "lmt": {
            "default": false,
            "description": "Local mean time at the longitude (lon/15 hours)",
            "title": "Lmt",
            "type": "boolean"
          },
          "lon": {
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Lon",
            "type": "number"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "settings": {
            "$ref": "#/components/schemas/SettingsIn"
          },
          "time": {
            "anyOf": [
              {
                "format": "time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "HH:MM[:SS]; may be omitted if time_known=false",
            "title": "Time"
          },
          "time_known": {
            "default": true,
            "title": "Time Known",
            "type": "boolean"
          },
          "today": {
            "format": "date",
            "title": "Today",
            "type": "string"
          },
          "tz": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "IANA zone, e.g. Asia/Kolkata",
            "title": "Tz"
          },
          "utc_offset": {
            "anyOf": [
              {
                "pattern": "^[+-][0-9]{2}:[0-9]{2}(:[0-9]{2})?$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Fixed offset from UTC, e.g. \"+05:30\"",
            "title": "Utc Offset"
          },
          "vargas": {
            "anyOf": [
              {
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Subset of [1, 2, 3, 4, 7, 9, 10, 12, 16, 20, 24, 27, 30, 40, 45, 60]; default all",
            "title": "Vargas"
          }
        },
        "required": [
          "date",
          "lat",
          "lon",
          "today"
        ],
        "title": "DailyRequest",
        "type": "object"
      },
      "DashaRequest": {
        "additionalProperties": false,
        "properties": {
          "depth": {
            "default": 1,
            "description": "Levels to expand below the addressed period",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Depth",
            "type": "integer"
          },
          "kundli": {
            "$ref": "#/components/schemas/KundliRequest"
          },
          "maha_index": {
            "description": "0-based position of the maha in the /kundli response list for this scheme (a lord can occur twice in the 120-year span)",
            "minimum": 0.0,
            "title": "Maha Index",
            "type": "integer"
          },
          "path": {
            "description": "Lords below the maha (antar, pratyantar, ...); may be empty",
            "items": {
              "type": "string"
            },
            "maxItems": 4,
            "title": "Path",
            "type": "array"
          },
          "scheme": {
            "enum": [
              "vimshottari",
              "yogini"
            ],
            "title": "Scheme",
            "type": "string"
          }
        },
        "required": [
          "kundli",
          "scheme",
          "maha_index"
        ],
        "title": "DashaRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
