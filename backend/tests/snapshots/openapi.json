  "info": {
    "description": "Vedic astrology calculation engine (Swiss Ephemeris) with an offline place search. All indices are 1-based and accompanied by machine keys; every instant is returned as `*_utc` and `*_local`.",
    "title": "Vedic Kundli API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/analysis": {
      "post": {
        "description": "The `/kundli` body plus optional `gender` and `now_utc` (default: the current time).\n\nReturns life `areas`, `income_sources`, `lucky`, `functional_roles` and `periods` (the\nrunning maha/antar/pratyantar with judgements, the antar and pratyantar `timeline` over\nthe next 24 months, monthly ratings, the three best and challenging months, and the\nSaturn/Jupiter transit overlays). Every statement has `why` and `ref`.",
        "operationId": "analysis_api_v1_analysis_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalysisRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Analysis Api V1 Analysis Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Chart analysis and 24-month timeline"
      }
    },
    "/api/v1/daily": {
      "post": {
        "description": "The `/kundli` body plus `today` (local date) and optional `current_lat`, `current_lon`,\n`current_tz` (default: the birth place and zone). Horas run from sunrise of `today` to the\nnext sunrise at the current place; `*_local` times are in the current zone.",
        "operationId": "daily_guidance_api_v1_daily_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DailyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Daily Guidance Api V1 Daily Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Today's guidance: horas, colours, conduct, decisions"
      }
    },
    "/api/v1/dasha": {
      "post": {
        "description": "Expand one maha of the `/kundli` response.\n\n`maha_index` is the 0-based position of the maha in `/kundli`'s `vimshottari` or `yogini`\nlist (the same lord can occur twice in the 120-year span, so a lord alone is ambiguous);\n`path` holds the lords below it (antar, pratyantar, ...), and `depth` the levels to\nexpand below the addressed period.",
        "operationId": "dasha_api_v1_dasha_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DashaRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Dasha Api V1 Dasha Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Dasha subtree on demand"
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness and ephemeris status"
      }
    },
    "/api/v1/kundli": {
      "post": {
        "operationId": "kundli_api_v1_kundli_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KundliRequest"
